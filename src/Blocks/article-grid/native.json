{
    "version": 2,
    "description": "Responsive article grid. Same fetch contract as article-list; the mobile Blade template lays it out as a grid instead of a stack.",
    "dataSource": {
        "kind": "posts",
        "endpoint": "content",
        "method": "GET",
        "params": {
            "post_type": "{{ attributes.postType }}",
            "per_page": "{{ attributes.count }}",
            "category": "{{ attributes.category }}"
        },
        "bind": "items",
        "ttl": 300,
        "swr": true
    }
}
