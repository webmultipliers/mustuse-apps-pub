{
    "version": 2,
    "description": "Container that fetches N posts and sets `context.post` once per iteration of its post-template child. Non-post-template siblings (header / footer) render once without the per-item context.",
    "dataSource": {
        "kind": "posts",
        "endpoint": "content",
        "method": "GET",
        "params": {
            "post_type": "{{ attributes.postType }}",
            "per_page":  "{{ attributes.count }}",
            "category":  "{{ attributes.category }}",
            "taxonomy":  "{{ attributes.taxonomy }}",
            "term":      "{{ attributes.term }}",
            "author":    "{{ attributes.author }}",
            "orderby":   "{{ attributes.orderby }}",
            "order":     "{{ attributes.order }}"
        },
        "bind": "items",
        "ttl": 300,
        "swr": true
    },
    "provides_context": "post"
}
