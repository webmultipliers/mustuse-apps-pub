{
    "$schema": "https://blockstudio.dev/schema/block",
    "apiVersion": 3,
    "name": "mustuse-apps-pub/breaking-banner",
    "title": "Breaking Banner",
    "category": "mustuse-apps-pub",
    "description": "High-visibility urgent news ribbon. Use sparingly — for actual breaking news.",
    "icon": "megaphone",
    "blockstudio": {
        "attributes": [
            {
                "id": "label",
                "type": "text",
                "label": "Badge Label",
                "default": "Breaking"
            },
            {
                "id": "headline",
                "type": "text",
                "label": "Headline",
                "default": ""
            },
            {
                "id": "linkUrl",
                "type": "text",
                "label": "Link URL",
                "default": "",
                "help": "Optional. Tapping the banner navigates here."
            }
        ],
        "appTypes": [ "mobile_ios", "mobile_android" ],
        "requiredCapabilities": []
    }
}
