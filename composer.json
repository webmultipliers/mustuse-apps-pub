{
    "name": "mustuse/mustuse-apps-pub",
    "description": "MustUse Apps — Publisher plugin for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2",
        "blockstudio/blockstudio": "^7.1",
        "woocommerce/action-scheduler": "^3.7"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "friendsofphp/php-cs-fixer": "^3.95",
        "mockery/mockery": "^1.6",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-phpunit/wp-phpunit": "^6.4",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MustUse\\Pub\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MustUse\\Pub\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "build": [
            "@composer install --optimize-autoloader --no-dev",
            "npm install",
            "npm run build"
        ],
        "dev": "npm run dev",
        "test": "@php vendor/bin/phpunit",
        "test:php": "@php vendor/bin/phpunit",
        "test:js": "npm test --silent",
        "test:coverage": "XDEBUG_MODE=coverage @php vendor/bin/phpunit --coverage-text --coverage-html coverage/php",
        "analyse": "@php -d memory_limit=2G vendor/bin/phpstan analyse --no-progress",
        "analyse:baseline": "@php -d memory_limit=2G vendor/bin/phpstan analyse --no-progress --generate-baseline=phpstan-baseline.neon --allow-empty-baseline",
        "lint": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "lint:fix": "@php vendor/bin/php-cs-fixer fix",
        "test:integration": "@php vendor/bin/phpunit -c phpunit-integration.xml.dist",
        "test:all": [
            "@test:php",
            "@test:js",
            "@analyse",
            "@lint"
        ],
        "preflight": [
            "@build",
            "php -l mustuse-apps-pub.php",
            "php -l src/Plugin.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
